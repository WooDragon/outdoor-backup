#!/bin/sh
#
# Outdoor Backup block hotplug trigger.
# Every add partition is a source candidate. The manager owns the safety gates.
#

[ "$SUBSYSTEM" = block ] || exit 0

BACKUP_MANAGER="/opt/outdoor-backup/scripts/backup-manager.sh"
SERVICE_STATE_SCRIPT="/opt/outdoor-backup/scripts/service-state.sh"
LOG_TAG="outdoor-backup-hotplug"

log_message() {
    logger -t "$LOG_TAG" "$1"
}

case "$ACTION" in
    add)
        [ "$DEVTYPE" = partition ] || exit 0
        if [ ! -r "$SERVICE_STATE_SCRIPT" ]; then
            log_message "service-state library unavailable: $SERVICE_STATE_SCRIPT; refusing add event"
            exit 1
        fi
        # shellcheck disable=SC1090
        . "$SERVICE_STATE_SCRIPT"
        if ! service_state_read; then
            log_message 'service state read failed; refusing add event'
            exit 1
        fi
        case "$SERVICE_STATE_MODE" in
            running) service_generation=$SERVICE_STATE_GENERATION ;;
            stopped) exit 0 ;;
            *)
                log_message 'service state mode is invalid; refusing add event'
                exit 1
                ;;
        esac
        log_message "source partition detected: $DEVNAME"
        (
            sleep 2
            OUTDOOR_BACKUP_SERVICE_GENERATION="$service_generation" \
                exec "$BACKUP_MANAGER" add "$DEVNAME" "$DEVPATH" "${SEQNUM:-}"
        ) &
        ;;
    remove)
        "$BACKUP_MANAGER" remove "$DEVNAME" "$DEVPATH" "${SEQNUM:-}" &
        ;;
esac

exit 0
